# ─── Supabase (Project Settings → API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used for seeds, admin and webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Postgres (Project Settings → Database → Connection string → Session pooler) ─
# Used only by scripts (migrations, seeds, RLS tests). Not loaded by the app runtime.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development            # development | staging | production

# ─── External providers (mock until real credentials exist) ──────────
PAYMENT_PROVIDER=mock          # mock | wompi | stripe
NOTIFICATION_PROVIDER=mock     # mock | whatsapp_cloud
EINVOICE_PROVIDER=mock         # mock | <proveedor tecnológico>
RIPS_PROVIDER=mock             # mock | minsalud
AI_PROVIDER=none               # none | openai | anthropic
# Regulatory endpoints always come from configuration, never hardcoded:
RIPS_MINSALUD_BASE_URL=
SIIFA_BASE_URL=
